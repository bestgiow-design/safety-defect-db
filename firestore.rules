rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // 總管理員用 email 寫死，確保 users 文件被動過也不會把自己鎖在外面
    function ownerEmail() {
      return signedIn() && request.auth.token.email == 'bestgiow@gmail.com';
    }
    function hasUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin()  { return ownerEmail() || (hasUserDoc() && myRole() == 'admin'); }
    function approved() { return ownerEmail() || (hasUserDoc() && myRole() in ['admin','staff','vendor']); }
    function canEdit()  { return ownerEmail() || (hasUserDoc() && myRole() in ['admin','staff']); }

    match /users/{uid} {
      allow get:  if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // 第一次登入前端會自建文件，但只能建成 pending，不能自己封自己當 admin
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.email == request.auth.token.email
                    && (request.resource.data.role == 'pending' || ownerEmail());
      allow update, delete: if isAdmin();
    }

    match /defects/{id} {
      allow read: if approved();
      allow create, update, delete: if canEdit();
    }

    match /projects/{id} {
      allow read: if approved();
      allow write: if canEdit();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
