rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /defects/{id} {
      allow read, write: if request.auth != null;
    }
    match /projects/{id} {
      allow read, write: if request.auth != null;
    }
    match /users/{uid} {
      // 本人可讀寫自己的文件（新使用者建立自己的記錄）
      allow read, write: if request.auth.uid == uid;
      // 管理員可讀寫所有使用者
      allow read, write: if request.auth.token.email == 'bestgiow@gmail.com';
    }
  }
}
